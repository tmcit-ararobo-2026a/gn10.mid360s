{
    "Mid360PointCloud": {
        "version": 1,
        "icon": "icons/isaac-sim.svg",
        "description": "Output point cloud generated by the simulated Livox Mid-360S LiDAR.",
        "language": "Python",
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": "gn10.mid360s",
        "metadata": {
            "uiName": "Mid360 Point Cloud"
        },
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Execution input."
            }
        },
        "outputs": {
            "execOut": {
                "type": "execution",
                "description": "Execution output."
            },
            "points": {
                "type": "pointf[3][]",
                "description": "Mid-360 XYZ point cloud."
            }
        }
    }
}