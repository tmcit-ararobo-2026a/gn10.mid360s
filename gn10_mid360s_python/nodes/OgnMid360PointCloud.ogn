{
    "Mid360PointCloud": {
        "version": 1,
        "icon": "icons/isaac-sim.svg",
        "description": "Output point cloud generated by the simulated Livox Mid-360S LiDAR.",
        "language": "Python",
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": "gn10.mid360s",
        "metadata": {
            "uiName": "Mid360S Point Cloud"
        },
        "inputs": {
            "execIn": {
                "type": "execution",
                "description": "Execution input. Mid360S scanning timing."
            },
            "sensorPrim": {
                "type": "target",
                "description": "USD prim reference to the Mid-360S prim",
                "metadata": {
                    "uiName": "Mid-360S Prim"
                }
            }
        },
        "outputs": {
            "execOut": {
                "type": "execution",
                "description": "Execution output."
            },
            "points": {
                "type": "pointf[3][]",
                "description": "Mid-360S XYZ point cloud."
            }
        }
    }
}